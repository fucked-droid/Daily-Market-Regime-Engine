# ==============================================================================
# Git Ignore Configuration
# Protects sensitive credentials, keys, cache, system files, and large binaries
# ==============================================================================

# --- Secrets, Credentials & Keys ---
.env
.env.*
*.key
*.pem
*.token
*.secret
*credentials*
*id_rsa*
*id_ed25519*
.ssh/

# --- Shell Configuration & History (contains API keys and terminal history) ---
.bashrc
.bash_history
.bash_profile
.bash_logout
.profile
.gitconfig
.wget-hsts
.termux/

# --- Antigravity CLI, Claude & IDE Internal State/Logs/Caches ---
.gemini/
.claude/
.cache/
.config/
.local/

# --- Python compilation artifacts & Virtual Environments ---
.venv/
.ipynb_checkpoints/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# --- Large Binary Files & Server Distributions ---
code-server-*/
code-server-*.tar.gz
*.tar.gz
*.tar
*.zip
*.iso

# --- Local Scripts & Standalone Tools ---
Scan_nifty.py
fetch_live_ipos.py

# --- System / OS / Editor Files ---
.DS_Store
Thumbs.db
.vscode/

# --- Local Secrets, State, and Telemetry ---
.telegram_config.json
.telegram_*state.json
*.bak
*.symlink_bak

# --- Nested Repositories & Submodules ---
Gemini-agent/
ipo_sentinel/

# --- Symlinks to external engines ---
Daily-Market-Regime-Engine
IPO-Intelligence-Engine
IPO-intelligence-Engine
package.json
run_sentinel.py

# --- Runtime Caches & Dynamic Scans ---
nifty_live_candles.json
nifty_momentum_scan_latest.json
scan_results.json

